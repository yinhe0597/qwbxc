      "right": "川流不息",
      "type": "成语",
      "note": "喻行人、车马像水流一样连续不断。"
    },
    {
      "id": "A068",
      "wrong": [
        "如愿以尝"
      ],
      "right": "如愿以偿",
      "type": "成语",
      "note": "“偿”指实现、满足。"
    },
    {
      "id": "A069",
      "wrong": [
