  "entries": [
    {
      "id": "A001",
      "wrong": [
        "亲睐"
      ],
      "right": "青睐",
      "type": "错别字",
      "note": "“青”指黑眼珠，青睐即垂青、喜爱。"
    },
    {
      "id": "A002",
      "wrong": [
        "情份"
      ],
      "right": "情分",
      "type": "错别字",
      "note": "“分”读 fèn，指情谊、缘分，不写作“份”。"
    },
    {
      "id": "A003",
      "wrong": [
        "一份子"
      ],
      "right": "一分子",
      "type": "错别字",
      "note": "“分子”指属于一定阶级、阶层、群体的人。"
    },
    {
      "id": "A004",
      "wrong": [
        "重要结点"
      ],
      "right": "重要节点",
      "type": "错别字",
      "note": "时间、进程中的关键位置用“节点”；“结点”为数学、网络术语。"
    },
    {
      "id": "A005",
      "wrong": [
        "旅游圣地",
        "革命圣地游"
      ],
      "right": "旅游胜地",
      "type": "错别字",
      "note": "风景优美之地为“胜地”；“圣地”指神圣之地，如革命圣地延安。"
    },
    {
      "id": "A006",
      "wrong": [
        "欠收"
      ],
      "right": "歉收",
      "type": "错别字",
      "note": "收成不好用“歉收”，与“丰收”相对。"
    },
    {
      "id": "A007",
      "wrong": [
        "窜改历史"
      ],
      "right": "篡改历史",
      "type": "错别字",
      "note": "用作伪手段改动重大、抽象内容用“篡改”；改动具体文字材料用“窜改”。"
    },
    {
      "id": "A008",
      "wrong": [
        "疫情爆发"
      ],
      "right": "疫情暴发",
      "type": "错别字",
      "note": "传染病、洪水等突然大量发生用“暴发”；火山、战争、掌声用“爆发”。"
    },
    {
      "id": "A009",
      "wrong": [
        "狙击战"
      ],
      "right": "阻击战",
      "type": "错别字",
      "note": "“狙击”指暗中伺机射击；“阻击”指以防御手段阻止敌人增援、逃跑或进攻。"
    },
    {
      "id": "A010",
      "wrong": [
        "一分力量",
        "一分贡献"
      ],
      "right": "一份力量",
      "type": "错别字",
      "note": "作量词表示整体中的一部分用“份”；“一分”仅用于钱币、时间、成绩等。"
    },
    {
      "id": "A011",
      "wrong": [
        "量子通讯卫星",
        "通讯卫星"
      ],
      "right": "量子通信卫星",
      "type": "错别字",
      "note": "传递信息统称“通信”；“通讯”指通讯社、通讯网或新闻体裁。"
    },
    {
      "id": "A012",
      "wrong": [
        "打黑除恶"
      ],
      "right": "扫黑除恶",
      "type": "表述",
      "note": "专项斗争规范提法为“扫黑除恶”。"
    },
    {
      "id": "A013",
      "wrong": [
        "土地流传"
      ],
      "right": "土地流转",
      "type": "错别字",
      "note": "土地经营权转移用“流转”。"
    },
    {
      "id": "A014",
      "wrong": [
        "常驻人口"
      ],
      "right": "常住人口",
      "type": "错别字",
      "note": "统计口径为“常住人口”，与“户籍人口”相对。"
    },
    {
      "id": "A015",
      "wrong": [
        "经济实用房"
      ],
      "right": "经济适用房",
      "type": "错别字",
      "note": "保障性住房的规范名称。"
    },
    {
      "id": "A016",
      "wrong": [
        "趟出一条新路"
      ],
      "right": "蹚出一条新路",
      "type": "错别字",
      "note": "“蹚”指从浅水中走过，喻探索；规范用例为“蹚出一条新路”。"
    },
    {
      "id": "A017",
      "wrong": [
        "靓丽名片"
      ],
      "right": "亮丽名片",
      "type": "错别字",
      "note": "“亮丽”指明亮美丽；“靓丽”多用于妆饰、服饰。"
    },
    {
      "id": "A018",
      "wrong": [
        "契而不舍"
      ],
      "right": "锲而不舍",
      "type": "成语",
      "note": "“锲”为雕刻，语出《荀子·劝学》。"
    },
    {
      "id": "A019",
      "wrong": [
        "慵懒散"
      ],
      "right": "庸懒散",
      "type": "表述",
      "note": "作风建设规范提法为“庸懒散”。"
    },
    {
      "id": "A020",
      "wrong": [
        "海清河晏"
      ],
      "right": "河清海晏",
      "type": "成语",
      "note": "黄河水清、大海平静，喻天下太平。"
    },
    {
      "id": "A021",
      "wrong": [
        "阴奉阳违"
      ],
      "right": "阳奉阴违",
      "type": "成语",
      "note": "表面上遵从，暗地里违背。"
    },
    {
      "id": "A022",
      "wrong": [
        "翻一翻"
      ],
      "right": "翻一番",
      "type": "表述",
      "note": "数量成倍增加用“番”；“翻一翻”指翻动一下。"
    },
    {
      "id": "A023",
      "wrong": [
        "再接再励"
      ],
      "right": "再接再厉",
      "type": "成语",
      "note": "“厉”通“砺”，指磨快，喻继续努力。"
    },
    {
      "id": "A024",
      "wrong": [
        "缀学"
      ],
      "right": "辍学",
      "type": "错别字",
      "note": "“辍”指中止、停止。"
    },
    {
      "id": "A025",
      "wrong": [
        "渔水情深"
      ],
      "right": "鱼水情深",
      "type": "成语",
      "note": "喻军民、干群关系亲密如鱼与水。"
    },
    {
      "id": "A026",
      "wrong": [
        "奋辑前行"
      ],
      "right": "奋楫前行",
      "type": "错别字",
      "note": "“楫”为船桨。"
    },
    {
      "id": "A027",
      "wrong": [
        "一路一带"
      ],
      "right": "一带一路",
      "type": "表述",
      "note": "全称“丝绸之路经济带和21世纪海上丝绸之路”。"
    },
    {
      "id": "A028",
      "wrong": [
        "神州飞船",
        "神州十二号"
      ],
      "right": "神舟飞船",
      "type": "专名",
      "note": "载人飞船为“神舟”，与“神州”含义不同。"
    },
    {
      "id": "A029",
      "wrong": [
        "修茸一新"
      ],
      "right": "修葺一新",
      "type": "错别字",
      "note": "“葺”读 qì，指修理房屋；“茸”读 róng，指草初生纤细柔软的样子。"
    },
    {
      "id": "A030",
      "wrong": [
        "蒸气弹射"
      ],
      "right": "蒸汽弹射",
      "type": "错别字",
      "note": "“蒸汽”专指水蒸气；“蒸气”泛指由液体或固体变成的气体。"
    },
    {
      "id": "A031",
      "wrong": [
        "筱面"
      ],
      "right": "莜面",
      "type": "错别字",
      "note": "“莜”读 yóu，指莜麦；“筱”读 xiǎo，指小竹子。"
    },
    {
      "id": "A032",
      "wrong": [
        "巨擎"
      ],
      "right": "巨擘",
      "type": "错别字",
      "note": "“擘”读 bò，指大拇指，喻杰出人物；“擎”读 qíng，指往上托举。"
    },
    {
      "id": "A033",
      "wrong": [
        "颂读"
      ],
      "right": "诵读",
      "type": "错别字",
      "note": "现代汉语无“颂读”一词。"
    },
    {
      "id": "A034",
      "wrong": [
        "雾淞",
        "雨淞"
      ],
      "right": "雾凇",
      "type": "错别字",
      "note": "水汽凝结物用“凇”；“淞”仅用于淞江（吴淞江）等水名。"
    },
    {
      "id": "A035",
      "wrong": [
        "无所是从"
      ],
      "right": "无所适从",
      "type": "成语",
      "note": "不知跟从谁好，形容不知怎么办。"
    },
    {
      "id": "A036",
      "wrong": [
        "栓马"
      ],
      "right": "拴马",
      "type": "错别字",
      "note": "“拴”为动词，用绳子系住；“栓”为名词，如消火栓。"
    },
    {
      "id": "A037",
      "wrong": [
        "蒜苔",
        "菜苔"
      ],
      "right": "蒜薹",
      "type": "错别字",
      "note": "“薹”指蒜、韭菜等抽出的花茎；“苔”指苔藓类植物。"
    },
    {
      "id": "A038",
      "wrong": [
        "唯妙唯肖",
        "维妙维肖"
      ],
      "right": "惟妙惟肖",
      "type": "成语",
      "note": "规范写法为“惟妙惟肖”。"
    },
    {
      "id": "A039",
      "wrong": [
        "对薄公堂"
      ],
      "right": "对簿公堂",
      "type": "成语",
      "note": "“簿”指文状、案卷。"
    },
    {
      "id": "A040",
      "wrong": [
        "财政拔款"
      ],
      "right": "财政拨款",
      "type": "错别字",
      "note": "“拨”指调拨、发给；“拔”指抽出、拉出。"
    },
    {
      "id": "A041",
      "wrong": [
        "拔通电话"
      ],
      "right": "拨通电话",
      "type": "错别字",
      "note": "拨号用“拨”。"
    },
    {
      "id": "A042",
      "wrong": [
        "经济版块"
      ],
      "right": "经济板块",
      "type": "错别字",
      "note": "“板块”指具有共同特征的区域；“版块”用于报刊版面。"
    },
    {
      "id": "A043",
      "wrong": [
        "完壁归赵"
      ],
      "right": "完璧归赵",
      "type": "成语",
      "note": "“璧”为古代玉器。"
    },
    {
      "id": "A044",
      "wrong": [
        "珠联壁合"
      ],
      "right": "珠联璧合",
      "type": "成语",
      "note": "喻美好的人或事物凑在一起。"
    },
    {
      "id": "A045",
      "wrong": [
        "淡薄名利"
      ],
      "right": "淡泊名利",
      "type": "成语",
      "note": "“淡泊”指不追求名利；“淡薄”指感情、兴趣不浓厚或印象不深。"
    },
    {
      "id": "A046",
      "wrong": [
        "博奕"
      ],
      "right": "博弈",
      "type": "错别字",
      "note": "“弈”指下棋。"
    },
    {
      "id": "A047",
      "wrong": [
        "长年累月"
      ],
      "right": "常年累月",
      "type": "成语",
      "note": "规范写法为“常年累月”，形容经历很多年月。"
    },
    {
      "id": "A048",
      "wrong": [
        "人材"
      ],
      "right": "人才",
      "type": "用字",
      "note": "现在规范用“人才”，不用“人材”。"
    },
    {
      "id": "A049",
      "wrong": [
        "减少了一倍",
        "降低一倍"
      ],
      "right": "减少了一半",
      "type": "表述",
      "note": "“倍”只用于增加，不能用于减少；可写“减少一半”“减少50%”“减少五成”。"
    },
    {
      "id": "A050",
      "wrong": [
        "记录薄",
        "练习薄"
      ],
      "right": "记录簿",
      "type": "错别字",
      "note": "本子、账册用“簿”；“薄”指单薄、轻视。"
    },
    {
      "id": "A051",
      "wrong": [
        "雕板"
      ],
      "right": "雕版",
      "type": "错别字",
      "note": "“版”指印刷用的底子。"
    },
    {
      "id": "A052",
      "wrong": [
        "精减机构"
      ],
      "right": "精简机构",
      "type": "错别字",
      "note": "“精简”指去掉不必要的，留下必要的。"
    },
    {
      "id": "A053",
      "wrong": [
        "里肌"
      ],
      "right": "里脊",
      "type": "错别字",
      "note": "指猪、牛、羊脊椎骨内侧的条状嫩肉。"
    },
    {
      "id": "A054",
      "wrong": [
        "挖墙角"
      ],
      "right": "挖墙脚",
      "type": "成语",
      "note": "喻拆台、从根本上损害别人。"
    },
    {
      "id": "A055",
      "wrong": [
        "黄梁一梦",
        "黄梁美梦"
      ],
      "right": "黄粱一梦",
      "type": "成语",
      "note": "“粱”指小米，典出唐传奇《枕中记》。"
    },
    {
      "id": "A056",
      "wrong": [
        "了了无几"
      ],
      "right": "寥寥无几",
      "type": "成语",
      "note": "“寥寥”指非常少。"
    },
    {
      "id": "A057",
      "wrong": [
        "迫不急待"
      ],
      "right": "迫不及待",
      "type": "成语",
      "note": "“及”指来得及。"
    },
    {
      "id": "A058",
      "wrong": [
        "可望而不可急"
      ],
      "right": "可望而不可即",
      "type": "成语",
      "note": "“即”指靠近、接近。"
    },
    {
      "id": "A059",
      "wrong": [
        "背景离乡"
      ],
      "right": "背井离乡",
      "type": "成语",
      "note": "“井”指乡井、家乡。"
    },
    {
      "id": "A060",
      "wrong": [
        "家俱"
      ],
      "right": "家具",
      "type": "错别字",
      "note": "“具”指器物。"
    },
    {
      "id": "A061",
      "wrong": [
        "溘然长逝",
        "磕然长逝"
      ],
      "right": "溘然长逝",
      "type": "错别字",
      "note": "“溘”读 kè，指忽然。"
    },
    {
      "id": "A062",
      "wrong": [
        "针贬时弊"
      ],
      "right": "针砭时弊",
      "type": "成语",
      "note": "“砭”指古代治病的石针。"
    },
    {
      "id": "A063",
      "wrong": [
        "脉膊"
      ],
      "right": "脉搏",
      "type": "错别字",
      "note": "“搏”指跳动。"
    },
    {
      "id": "A064",
      "wrong": [
        "松驰"
      ],
      "right": "松弛",
      "type": "错别字",
      "note": "“弛”指放松弓弦，引申为放松。"
    },
    {
      "id": "A065",
      "wrong": [
        "寒喧"
      ],
      "right": "寒暄",
      "type": "错别字",
      "note": "“暄”指太阳温暖。"
    },
    {
      "id": "A066",
      "wrong": [
        "直接了当"
      ],
      "right": "直截了当",
      "type": "成语",
      "note": "形容说话做事爽快。"
    },
    {
      "id": "A067",
      "wrong": [
        "穿流不息"
