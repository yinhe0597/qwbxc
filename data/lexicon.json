    },
    {
      "id": "A074",
      "wrong": [
        "座落"
      ],
      "right": "坐落",
      "type": "错别字",
      "note": "指建筑物位置在某个地方。"
    },
    {
      "id": "A075",
      "wrong": [
        "峻工"
      ],
      "right": "竣工",
      "type": "错别字",
      "note": "“竣”指完毕。"
    },
    {
      "id": "A076",
      "wrong": [
        "布署"
      ],
      "right": "部署",
      "type": "错别字",
      "note": "“部署”指安排、布置。"
    },
    {
      "id": "A077",
      "wrong": [
        "题纲"
      ],
      "right": "提纲",
      "type": "错别字",
      "note": "“提纲”指内容要点。"
    },
    {
      "id": "A078",
      "wrong": [
